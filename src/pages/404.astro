---
import SiteLayout from '../layouts/SiteLayout.astro';
const description = '요청한 페이지를 찾을 수 없습니다. EMFLS Storage 홈에서 정리 기준을 다시 살펴보세요.';
---

<SiteLayout title="페이지를 찾을 수 없습니다" description={description} noindex>
  <div class="article-shell"><section class="article page-width" aria-labelledby="not-found-title">
    <header class="article-header"><p class="eyebrow">404 / PAGE NOT FOUND</p><h1 id="not-found-title">페이지를 찾을 수 없습니다</h1><p class="article-intro">주소가 바뀌었거나 페이지가 이동했을 수 있습니다. 홈에서 공간과 물건에 맞는 정리 순서를 다시 확인해 보세요.</p></header>
    <p class="hero-actions"><a class="button-link" href="/">EMFLS Storage 홈으로</a></p>
  </section></div>
</SiteLayout>
